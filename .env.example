# Lista opcional de até três endpoints HTTPS, separados por vírgula, para failover controlado.
OVERPASS_API_URLS=
COMMUNITY_PLACES_ENABLED=false
COMMUNITY_UPLOAD_DIRECTORY=./data/community-photos
# Fotos ficam pendentes para moderação. Ative apenas com processo operacional aprovado.
COMMUNITY_PHOTO_AUTO_PUBLISH=false

# Gateway de rastreador físico: J16/GT06 -> Traccar -> webhook autenticado RASTREON.
# Gateway TCP direto de rastreadores físicos. O padrão é local por segurança;
# altere TRACKER_GATEWAY_HOST para 0.0.0.0 somente após revisar firewall/DNS.
TRACKER_GATEWAY_HOST=127.0.0.1
TRACKER_TCP_PORT=5023
TRACKER_MAX_CONNECTION_BUFFER_BYTES=65536
TRACKER_IDLE_TIMEOUT_MS=180000
TRACKER_INSPECTOR_ENABLED=false
TRACKER_REQUIRE_DEVICE_AUTH=true

# Integração legada opcional (não usada pelo gateway direto).
TRACCAR_ENABLED=false
TRACCAR_WEBHOOK_SECRET=
TRACCAR_DEVICE_HASH_SECRET=
# Bloqueio físico permanece indisponível por segurança.
FEATURE_REMOTE_BLOCK_HARDWARE=false
ADMIN_2FA_REQUIRED=true
