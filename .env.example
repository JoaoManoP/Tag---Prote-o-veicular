PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
# Em produção, use NODE_ENV=production e uma PUBLIC_URL HTTPS.
SESSION_SECRET=substitua-por-um-segredo-longo-e-aleatorio
DATABASE_PATH=./data/rastreon.sqlite
BACKUP_DIRECTORY=./backups
# 0 desativa a limpeza automática. Em produção, defina a política aprovada (ex.: 90 dias).
DATA_RETENTION_DAYS=0

# Mapa Mapbox com token público restrito aos domínios autorizados.
MAP_PROVIDER=mapbox
ALLOW_MAP_FALLBACK=true
ENABLE_DEV_TOOLS=false
MAP_STYLE_URL=mapbox://styles/mapbox/navigation-day-v1
MAPBOX_WEB_PUBLIC_TOKEN=pk.eyJ1Ijoiam9hb21hbm9lbHBlcmEiLCJhIjoiY21zeXFycmM1MDF4bjJ4cTFwYnBndmxsNCJ9.xbWLhdh8QZ2VqqIuaZxFiA
GEOCODING_PROVIDER=photon
PHOTON_API_URL=https://photon.komoot.io
# Nominatim público proíbe este caso de uso. Informe somente instância própria/contratada.
NOMINATIM_BASE_URL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Consulta veicular. Token opcional conforme a conta/provedor contratado.
PLATE_LOOKUP_URL=https://placa-fipe.apibrasil.com.br/placa/consulta
PLATE_LOOKUP_TOKEN=
FIPE_API_URL=https://brasilapi.com.br/api/fipe/preco/v1

# Clima atual por coordenadas. Mantenha a chave somente no backend.
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1

# osrm (padrão, sem chave) ou google
ROUTE_PROVIDER=osrm

# Necessária somente quando ROUTE_PROVIDER=google.
# Nunca coloque a chave em HTML, JavaScript público ou URLs do frontend.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
