PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=substitua-por-um-segredo-longo-e-aleatorio
DATABASE_PATH=./data/rastreon.sqlite

# Mapa vetorial gratuito, sem chave. Use "google" apenas como fallback opcional.
MAP_PROVIDER=maplibre
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
GEOCODING_PROVIDER=photon

# Consulta veicular. Token opcional conforme a conta/provedor contratado.
PLATE_LOOKUP_URL=https://placa-fipe.apibrasil.com.br/placa/consulta
PLATE_LOOKUP_TOKEN=

# osrm (padrão, sem chave) ou google
ROUTE_PROVIDER=osrm

# Necessária somente quando ROUTE_PROVIDER=google.
# Nunca coloque a chave em HTML, JavaScript público ou URLs do frontend.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
